# --- Scraper ---
FIRECRAWL_API_KEY=fc-your-key-here

# --- Jev (TypeSafe System One) ---
JEV_API_KEY=your-jev-key-here
JEV_MODEL=jev

# --- OpenAI (the single summary call) ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# --- Thresholds (policy lives in code/env, not the model) ---
SEVERITY_CONF_MIN=0.60
relevant_prob_min=0.60
NOISE_PROB_MAX=0.70



# --- Email (Resend) ---
RESEND_API_KEY=re_your-key-here
DIGEST_FROM=Sentinel <onboarding@resend.dev>
DIGEST_TO=your-email@example.com
SEND_EMAIL=True

# --- CORS: your Vercel frontend origin ---
ALLOWED_ORIGINS=http://localhost:5173

# --- Database: OFF by default. Set both to enable Neon. ---
USE_DB=false
DATABASE_URL=
