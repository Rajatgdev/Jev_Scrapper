# --- Scraper ---
FIRECRAWL_API_KEY=fc-your-key-here

# --- Jev (TypeSafe System One) ---
JEV_API_KEY=your-jev-key-here
JEV_MODEL=jev

# --- OpenAI (the single summary call) ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# --- Thresholds (policy lives in code/env, not the model) ---
SEVERITY_CONF_MIN=0.60
RELEVANT_CONF_MIN=0.60
NOISE_PROB_MAX=0.70

# --- The topic sentence Jev judges relevance against. Edit to re-aim the monitor. ---
TOPIC_QUESTION=Is this change about customs rules affecting chemical products?

# --- Email (fill when wiring digest send) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
DIGEST_TO=

# --- CORS: your Vercel frontend origin ---
ALLOWED_ORIGINS=http://localhost:5173

# --- Database: OFF by default. Set both to enable Neon. ---
USE_DB=false
DATABASE_URL=
